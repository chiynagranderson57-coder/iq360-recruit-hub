# Copy to .env for local development. PUBLIC, client-safe values only.
# Never put a service-role key, sb_secret_ key, DB password, or JWT secret here.
VITE_SUPABASE_URL=https://lqthjvzjkbwtggrhgpts.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: debug | info | warn | error (default: debug in dev, info in builds)
VITE_LOG_LEVEL=
# Feature flags default OFF. Set to "true" per environment to enable.
VITE_FLAG_ATHLETE_SLICE=
VITE_FLAG_ASK_NAVARIA_LIVE=
VITE_FLAG_AGENT_INTEGRATIONS=
